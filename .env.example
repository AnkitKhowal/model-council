# Demo mode is safe for reviewers and does not make billable inference requests.
DEMO_MODE=true

# Set DEMO_MODE=false and configure these values for live DigitalOcean inference.
DIGITALOCEAN_INFERENCE_KEY=
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
SYNTHESIZER_MODEL_ID=openai-gpt-oss-120b
USE_NATIVE_MODEL_SYNTHESIS=true

# Use the deployed origin in production so social-preview metadata is absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
